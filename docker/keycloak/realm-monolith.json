{
  "realm": "monolith",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Standard user"
      },
      {
        "name": "ADMIN",
        "description": "Administrator"
      }
    ],
    "client": {
      "monolith-api": [
        {
          "name": "USER",
          "description": "User role for API client",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "users": [
    {
      "username": "demo-user",
      "email": "demo-user@example.com",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ],
      "realmRoles": ["USER"]
    }
  ],
  "clients": [
    {
      "clientId": "monolith-api",
      "name": "Monolith API",
      "enabled": true,
      "publicClient": false,
      "secret": "monolith-api-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"],
      "protocol": "openid-connect",
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"]
    }
  ],
  "clientScopeMappings": {
    "monolith-api": [
      {
        "client": "monolith-api",
        "roles": ["USER"]
      }
    ]
  }
}
