SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/monolith
SPRING_DATASOURCE_USERNAME=monolith
SPRING_DATASOURCE_PASSWORD=monolith
SPRING_DATA_REDIS_HOST=localhost
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_USERNAME=monolith
SPRING_RABBITMQ_PASSWORD=monolith
SENTRY_DSN=
NOTIFICATION_PLATFORM_ENABLED=false
# OTLP (Jaeger/Tempo). Deixe false sem coletor rodando.
OTEL_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_TRANSPORT=grpc
OTEL_SERVICE_NAME=spring-service-monolith
MAIL_HOST=localhost
MAIL_PORT=1025
